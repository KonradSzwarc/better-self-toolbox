---
import Toolbox from '@/assets/toolbox.svg';
import { cn } from '@/utils/styles';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {}

const { class: className, ...rest } = Astro.props;
---

<section class={cn('grid place-items-center p-10 text-center', className)} {...rest}>
  <Toolbox class="size-36" />
  <h1 class="mb-4 font-heading text-4xl font-black tracking-widest uppercase">Better Self Toolbox</h1>
  <p class="max-w-2xl text-lg text-balance">
    A comprehensive collection of tools to help you think clearly, choose wisely, and grow meaningfully.
  </p>
</section>
