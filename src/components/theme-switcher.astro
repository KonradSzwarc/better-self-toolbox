---
import { getTranslations } from '@/utils/i18n';
import { ThemeSwitcherPreact } from './theme-switcher.preact';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const t = getTranslations(Astro, 'components.theme_switcher');
---

<ThemeSwitcherPreact
  client:only="preact"
  label={t('label')}
  labels={{
    light: t('light'),
    dark: t('dark'),
    system: t('system'),
  }}
  className={className}
>
  <div slot="fallback" class="size-9"></div>
</ThemeSwitcherPreact>
