---
import { getTranslations } from '@/utils/i18n';
import { cn } from '@/utils/styles';
import { ThemeSwitcherPreact } from './theme-switcher.preact';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const t = getTranslations(Astro, 'components.theme_switcher');
---

<ThemeSwitcherPreact
  client:only="preact"
  label={t('label')}
  labels={{
    light: t('light'),
    dark: t('dark'),
    system: t('system'),
  }}
  className={className}
>
  <div
    slot="fallback"
    class={cn(
      'size-12 rounded-2xl border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-800',
      className,
    )}
  >
  </div>
</ThemeSwitcherPreact>
