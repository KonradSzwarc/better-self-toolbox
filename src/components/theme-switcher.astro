---
import { getLocale, getTranslations } from '@/utils/i18n';
import { ThemeSwitcherPreact } from './theme-switcher.preact';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const locale = getLocale(Astro);
const t = getTranslations(locale);
---

<ThemeSwitcherPreact
  client:only="preact"
  label={t('components.theme_switcher.label')}
  labels={{
    light: t('components.theme_switcher.light'),
    dark: t('components.theme_switcher.dark'),
    system: t('components.theme_switcher.system'),
  }}
  className={className}
/>
