---
import { cn } from '@/utils/styles';
import { Fragment } from 'astro/jsx-runtime';
import type { HTMLAttributes } from 'astro/types';
import { getCollection } from 'astro:content';
import TagFilter from './tag-filter.astro';

interface Props extends HTMLAttributes<'ul'> {}

const { class: className, ...rest } = Astro.props;

const tags = await getCollection('tags');

const selectedTag = Astro.url.searchParams.get('tag') || 'all';
---

<>
  <ul data-tag-filters class={cn('flex flex-wrap justify-center gap-2', className)} {...rest}>
    <TagFilter value="all" checked={selectedTag === 'all'}>All</TagFilter>
    {
      tags.map((tag) => (
        <TagFilter data-tooltip-id={tag.id} value={tag.id} checked={selectedTag === tag.id}>
          {tag.data.name}
        </TagFilter>
      ))
    }
  </ul>
  {
    tags.map((tag) => (
      <div
        role="tooltip"
        data-for={tag.id}
        class="z-20 max-w-[calc(100%-1rem)] rounded-lg border border-black bg-white px-4 py-3 text-pretty shadow-md md:max-w-[520px]"
      >
        {tag.data.summary}
      </div>
    ))
  }
</>

<style>
  div[role='tooltip'] {
    position: absolute;
    top: 0;
    left: 0;
    width: max-content;
    margin: 0 !important;
    animation: show 200ms ease-out 0ms forwards;
    opacity: 0;
    display: none;
  }

  @keyframes show {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  import { autoUpdate, computePosition, flip, offset, shift } from '@floating-ui/dom';

  function registerTooltips() {
    for (const item of document.querySelectorAll('[data-tag-filters] [data-tooltip-id]')) {
      if (!(item instanceof HTMLElement)) continue;

      const tooltip = document.querySelector(`[role="tooltip"][data-for="${item.dataset.tooltipId}"]`);
      if (!(tooltip instanceof HTMLElement)) continue;

      autoUpdate(item, tooltip, () => updatePosition(item, tooltip));
      addTooltipListeners(item, tooltip, () => updatePosition(item, tooltip));
    }
  }

  function registerTags() {
    const tags = document.querySelectorAll('[data-tag-checkbox]') as NodeListOf<HTMLInputElement>;
    const selectedTag = new URL(window.location.href).searchParams.get('tag') || 'all';

    tags.forEach((tag) => {
      tag.checked = tag.value === selectedTag;

      tag.addEventListener('change', (e) => {
        const tagElement = e.target as HTMLInputElement;
        const selectedTag = tagElement.checked ? tagElement.value : 'all';

        tags.forEach((tag) => {
          tag.checked = tag.value === selectedTag;
        });

        const url = new URL(window.location.href);

        if (selectedTag === 'all') {
          url.searchParams.delete('tag');
        } else {
          url.searchParams.set('tag', selectedTag);
        }

        history.replaceState(null, '', url.toString());
        window.dispatchEvent(new Event('query-change'));
      });
    });
  }

  registerTags();
  registerTooltips();

  function updatePosition(trigger: HTMLElement, tooltip: HTMLElement) {
    computePosition(trigger, tooltip, {
      middleware: [offset(12), flip(), shift({ padding: 8 })],
      placement: 'top',
    }).then(({ x, y }) => {
      Object.assign(tooltip.style, {
        left: `${x}px`,
        top: `${y}px`,
      });
    });
  }

  function addTooltipListeners(trigger: HTMLElement, tooltip: HTMLElement, updateFn: () => void) {
    trigger.addEventListener('mouseenter', show(1000));
    trigger.addEventListener('touchstart', show(300));
    trigger.addEventListener('mouseleave', hide);
    trigger.addEventListener('touchend', hide);
    trigger.addEventListener('click', hide);

    function show(delay: number) {
      return () => {
        tooltip.style.display = 'block';
        tooltip.style.animationDelay = `${delay}ms`;
        updateFn();
      };
    }

    function hide() {
      tooltip.style.display = 'none';
      tooltip.style.animationDelay = '0ms';
    }
  }
</script>
