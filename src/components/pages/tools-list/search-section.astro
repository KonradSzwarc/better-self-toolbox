---
import { cn } from '@/utils/styles';
import { Fragment } from 'astro/jsx-runtime';
import type { HTMLAttributes } from 'astro/types';
import TagFilters from './tag-filters.astro';
import SearchInput from './search-input.astro';

interface Props extends HTMLAttributes<'section'> {}

const { class: className, ...rest } = Astro.props;
---

<section class={cn('flex max-w-4xl flex-col items-center', className)} {...rest}>
  <SearchInput class="mb-4 w-full max-w-xl" />
  <TagFilters class="mt-4" />
</section>
