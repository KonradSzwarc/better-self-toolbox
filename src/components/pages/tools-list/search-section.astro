---
import { cn } from '@/utils/styles';
import { Fragment } from 'astro/jsx-runtime';
import type { HTMLAttributes } from 'astro/types';
import { SearchInputReact } from './search-input.react';
import { TagFiltersReact } from './tag-filters.react';
import { entriesForLocale, getLocale, getTranslations, omitLocale } from '@/utils/i18n';
import { getCollection } from 'astro:content';

interface Props extends HTMLAttributes<'section'> {}

const { class: className, ...rest } = Astro.props;

const locale = getLocale(Astro);
const t = getTranslations(locale);

const tagsCollection = await getCollection('tags', entriesForLocale(locale));
const tags = tagsCollection.map((tag) => ({ id: omitLocale(tag.id), name: tag.data.name, summary: tag.data.summary }));
---

<section class={cn('flex max-w-4xl flex-col items-center', className)} {...rest}>
  <SearchInputReact
    client:load
    className="mb-4 w-full max-w-xl"
    placeholder={t('pages.tools_list.search')}
    initialValue={Astro.url.searchParams.get('search')}
  />
  <TagFiltersReact
    client:load
    tags={tags}
    className="mt-4"
    label={t('pages.tools_list.tag_filters_label')}
    allTagLabel={t('pages.tools_list.all_tag')}
    initialValue={Astro.url.searchParams.get('tag')}
  />
</section>
