---
import { getCollection } from 'astro:content';
import IconToolbox from '~icons/mdi/toolbox';
import Layout from '@/layouts/layout.astro';
import { entriesForLocale, getLocale, getTranslations, localizedPath, omitLocale } from '@/utils/i18n';
import { cn } from '@/utils/styles';
import { publishedToolsForLocale } from '@/utils/tools';
import Header from './header.astro';
import SearchInput from './search-input.astro';
import TagFilters from './tag-filters.astro';
import ToolsGrid from './tools-grid.astro';

const locale = getLocale(Astro);
const t = getTranslations(Astro, 'pages.tools_list');

const tagsCollection = await getCollection('tags', entriesForLocale(locale));
const toolsCollection = await getCollection('tools', publishedToolsForLocale(locale));

const tags = tagsCollection
  .map((tag) => ({
    id: omitLocale(tag.id),
    name: tag.data.name,
  }))
  .toSorted((a, b) => a.name.localeCompare(b.name));
const tagsMap = new Map(tags.map((tag) => [tag.id, tag]));

const tools = toolsCollection
  .map((tool) => ({
    id: omitLocale(tool.id),
    name: tool.data.name,
    summary: tool.data.summary,
    synonyms: tool.data.synonyms || [],
    url: localizedPath(`/${omitLocale(tool.data.path ?? tool.id)}`, locale),
    tags: tool.data.tags.map((tag) => tagsMap.get(tag.id)).filter(Boolean),
  }))
  .toSorted((a, b) => a.name.localeCompare(b.name));
---

<Layout title={t('seo.title')} description={t('seo.description')}>
  <Header slot="header" />
  <main class="container mx-auto grid place-items-center px-4 py-6 sm:py-10 md:py-20">
    <section class="flex flex-col items-center py-6 text-center sm:px-4 md:px-10">
      <div class={cn('logoBox', 'mb-6')}>
        <IconToolbox />
      </div>
      <h1 class="mb-4">{t('title')}</h1>
      <h2>{t('description')}</h2>
    </section>

    <section class="mt-4 mb-12 flex max-w-5xl flex-col items-center">
      <SearchInput className="mb-4" placeholder={t('search')} />
      <TagFilters tags={tags} className="mt-2 sm:mt-4" label={t('tag_filters_label')} allTagLabel={t('all_tag')} />
    </section>

    <section data-tools-section class="flex w-full flex-col items-center">
      <ToolsGrid
        tools={tools}
        i18n={{
          noResultsForSearch: t('no_results_for_search'),
          noResultsForSearchAndTag: t('no_results_for_search_and_tag'),
        }}
      />
    </section>
  </main>
</Layout>

<style>
  @reference '@/styles/global.css';

  h1 {
    @apply font-heading text-3xl leading-tight font-black text-primary sm:text-4xl md:text-5xl;
  }

  h2 {
    @apply max-w-2xl leading-relaxed text-balance text-secondary sm:text-lg md:text-xl;
  }

  .logoBox {
    @apply rounded-2xl bg-gradient-to-br gradient-primary p-4 shadow-xl;
    @apply shadow-blue-500/25 dark:shadow-blue-400/20;

    svg {
      @apply size-12 text-white sm:size-16;
    }
  }
</style>

<style is:global>
  /* https://aykevl.nl/2014/09/fix-jumping-scrollbar */

  @media (hover: hover) {
    html {
      margin-right: 0;
      margin-left: calc(100vw - 100%);
    }

    footer {
      margin-left: calc(100% - 100vw);
    }
  }
</style>
