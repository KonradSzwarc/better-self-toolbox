---
import { getCollection } from 'astro:content';
import IconToolbox from '~icons/mdi/toolbox';
import Layout from '@/layouts/layout.astro';
import { entriesForLocale, getLocale, getTranslations, localizedPath, omitLocale } from '@/utils/i18n';
import { publishedToolsForLocale } from '@/utils/tools';
import SearchInput from './search-input.astro';
import TagFilters from './tag-filters.astro';
import ToolsGrid from './tools-grid.astro';

const locale = getLocale(Astro);
const t = getTranslations(Astro, 'pages.tools_list');

const tagsCollection = await getCollection('tags', entriesForLocale(locale));
const toolsCollection = await getCollection('tools', publishedToolsForLocale(locale));

const tags = tagsCollection.map((tag) => ({
  id: omitLocale(tag.id),
  name: tag.data.name,
  summary: tag.data.summary,
}));
const tagsMap = new Map(tags.map((tag) => [tag.id, tag]));

const tools = toolsCollection.map((tool) => ({
  id: omitLocale(tool.id),
  name: tool.data.name,
  summary: tool.data.summary,
  synonyms: tool.data.synonyms || [],
  url: localizedPath(`/${omitLocale(tool.data.path ?? tool.id)}`, locale),
  tags: tool.data.tags.map((tag) => tagsMap.get(tag.id)).filter(Boolean),
}));
---

<Layout title={t('seo.title')} description={t('seo.description')}>
  <main class="container mx-auto grid place-items-center px-4 pt-8 pb-10">
    <section class="flex flex-col items-center px-4 py-6 text-center md:px-10">
      <div class="mb-6 flex items-center justify-center">
        <div
          class="rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 p-4 shadow-xl shadow-blue-500/25 dark:shadow-blue-400/20"
        >
          <IconToolbox className="size-16 text-white" />
        </div>
      </div>
      <h1 class="mb-4 font-heading text-4xl leading-tight font-black text-text-primary md:text-5xl">
        {t('title')}
      </h1>
      <h2 class="max-w-2xl text-lg leading-relaxed text-balance text-text-secondary md:text-xl">
        {t('description')}
      </h2>
    </section>

    <section class="mt-4 mb-12 flex max-w-5xl flex-col items-center">
      <SearchInput className="mb-4 w-full max-w-xl" placeholder={t('search')} />
      <TagFilters tags={tags} className="mt-4" label={t('tag_filters_label')} allTagLabel={t('all_tag')} />
    </section>

    <section data-tools-section class="flex flex-col items-center">
      <ToolsGrid
        tools={tools}
        i18n={{
          noResultsForSearch: t('no_results_for_search'),
          noResultsForSearchAndTag: t('no_results_for_search_and_tag'),
        }}
      />
    </section>
  </main>
</Layout>
