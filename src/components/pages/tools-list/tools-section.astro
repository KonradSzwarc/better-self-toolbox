---
import { createSearch } from '@/utils/search';
import { cn } from '@/utils/styles';
import type { HTMLAttributes } from 'astro/types';
import { getCollection } from 'astro:content';
import { entriesForLocale, prependLocale, localizedPath, getLocale, omitLocale } from '@/utils/i18n';

interface Props extends HTMLAttributes<'section'> {}

const { class: className, ...rest } = Astro.props;

const locale = getLocale(Astro);
const tools = await getCollection('tools', entriesForLocale(locale));
const tags = await getCollection('tags', entriesForLocale(locale));

const search = createSearch(
  tools.map((tool) => ({
    id: omitLocale(tool.id),
    name: tool.data.name,
    synonyms: tool.data.synonyms || [],
    tags: tool.data.tags.map((tag) => tag.id),
  })),
);
const searchParams = new URL(Astro.url).searchParams;
const idsToShow = search(searchParams.get('search'), searchParams.get('tag'));
---

<section class={cn('flex flex-col items-center', className)} {...rest}>
  <ul data-tools-list class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
    {
      tools
        .toSorted((a, b) => a.data.name.localeCompare(b.data.name))
        .map((tool) => (
          <li
            data-tool-id={omitLocale(tool.id)}
            data-synonyms={tool.data.synonyms?.join(',') || undefined}
            class={cn('flex flex-col border px-4 py-3', !idsToShow.has(omitLocale(tool.id)) && 'hidden')}
          >
            <h3 class="font-heading text-xl font-black">
              <a href={localizedPath(`/tools/${tool.id}`, locale)} class="hover:underline">
                {tool.data.name}
              </a>
            </h3>
            <p class="text-pretty">{tool.data.summary}</p>
            <ul class="mt-auto flex flex-wrap gap-1.5 pt-6">
              {tool.data.tags.map((tag) => (
                <li data-tag-id={tag.id} class="w-fit bg-zinc-200 px-2 py-0.5 text-xs font-medium">
                  {tags.find((t) => t.id === prependLocale(tag.id, locale))?.data.name}
                </li>
              ))}
            </ul>
          </li>
        ))
    }
  </ul>
</section>

<script>
  import { createSearch } from '@/utils/search';

  function registerParamsObserver() {
    const toolsList = document.querySelector('[data-tools-list]');
    if (!toolsList) return;

    const toolItems = [...toolsList.querySelectorAll('[data-tool-id]')] as HTMLLIElement[];

    const search = createSearch(
      toolItems.map((tool) => ({
        id: tool.dataset.toolId!,
        name: tool.querySelector('h3')?.textContent ?? '',
        synonyms: tool.dataset.synonyms?.split(',') || [],
        tags: [...(tool.querySelectorAll('[data-tag-id]') as NodeListOf<HTMLLIElement>)].map(
          (tag) => tag.dataset.tagId!,
        ),
      })),
    );

    function handleQueryChange() {
      const searchParams = new URL(window.location.href).searchParams;
      const idsToShow = search(searchParams.get('search'), searchParams.get('tag'));

      for (const li of toolItems) {
        if (idsToShow.has(li.dataset.toolId!)) {
          li.classList.replace('hidden', 'flex');
        } else {
          li.classList.replace('flex', 'hidden');
        }
      }
    }

    window.addEventListener('load', handleQueryChange);
    window.addEventListener('query-change', handleQueryChange);
  }

  registerParamsObserver();
</script>
