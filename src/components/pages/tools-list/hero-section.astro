---
import { getLocale, getTranslations } from '@/utils/i18n';
import { cn } from '@/utils/styles';
import type { HTMLAttributes } from 'astro/types';
import IconToolbox from '~icons/mdi/toolbox';

interface Props extends HTMLAttributes<'section'> {}

const { class: className, ...rest } = Astro.props;

const locale = getLocale(Astro);
const t = getTranslations(locale);
---

<section class={cn('grid place-items-center p-10 text-center', className)} {...rest}>
  <IconToolbox class="size-36" />
  <h1 class="mb-4 font-heading text-4xl font-black tracking-widest uppercase">{t('pages.tools_list.title')}</h1>
  <p class="max-w-2xl text-xl text-balance">{t('pages.tools_list.description')}</p>
</section>
