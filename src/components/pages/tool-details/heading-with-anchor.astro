---
import { cn } from '@/utils/styles';
import type { HTMLAttributes } from 'astro/types';
import MdiLinkVariant from '~icons/mdi/link-variant';

export interface Props extends HTMLAttributes<'h2' | 'h3'> {
  as: 'h2' | 'h3';
  label: string;
}

const { as: Component, label, id, class: className, ...props } = Astro.props;
---

<div class="group has-[h2]:prose-h2-sizing has-[h3]:prose-h3-sizing">
  <Component id={id} class={cn('mt-0 mr-[0.25em] mb-0 inline scroll-mt-6 text-[length:inherit]', className)} {...props}>
    <slot />
  </Component>
  <a
    href={`#${id}`}
    class="anchor-link inline-block pb-0.5 align-middle text-foreground opacity-40 group-hover:opacity-40 hover-supported:opacity-0"
  >
    <MdiLinkVariant width="1em" height="1em" aria-hidden="true" />
    <span class="sr-only">{label}</span>
  </a>
</div>
