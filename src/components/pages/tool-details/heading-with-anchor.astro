---
import type { HTMLAttributes } from 'astro/types';
import { getTranslations } from '@/utils/i18n';

export interface Props extends HTMLAttributes<'h2' | 'h3'> {
  as: 'h2' | 'h3';
}

const { as: Component, id, ...props } = Astro.props;

const t = getTranslations(Astro, 'pages.tool_details');

const isFootnoteHeading = id === 'footnote-label';
const footnoteLabel = t('footnotes');
const label = isFootnoteHeading ? footnoteLabel : await Astro.slots.render('default');
---

<div {...props}>
  <Component id={id} {...props}>
    {isFootnoteHeading ? footnoteLabel : <slot />}
  </Component>
  <a href={`#${id}`}>
    <svg width="1em" height="1em" viewBox="0 0 24 24">
      <use href="#link-icon"></use>
    </svg>
    <span class="sr-only">{t('anchor_label', { name: label })}</span>
  </a>
</div>

<style>
  @reference '@/styles/global.css';

  div:hover a {
    @media (hover: hover) {
      @apply opacity-40;
    }
  }

  a {
    @apply inline-block pb-0.5 align-middle opacity-40 transition-opacity duration-200;

    @media (hover: hover) {
      @apply opacity-0;
    }
  }
</style>
