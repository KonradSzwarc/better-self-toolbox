---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import Layout from '@/layouts/layout.astro';
import { getLocale, getTranslations, localizedPath, prependLocale } from '@/utils/i18n';
import IconArrowBack from '~icons/mdi/arrow-back';

interface Props {
  tool: CollectionEntry<'tools'>;
}

const locale = getLocale(Astro);
const t = getTranslations(locale);

const { tool } = Astro.props;

const tags = await getCollection('tags', (tag) => tool.data.tags.some((t) => prependLocale(t.id, locale) === tag.id));

const { Content } = await render(tool);

function toSortedList(items: string[]) {
  return items.toSorted((a, b) => a.localeCompare(b)).join(', ');
}
---

<Layout title={tool.data.name}>
  <main class="container mx-auto grid place-items-center px-4 py-10">
    <nav class="mb-8 w-full max-w-prose">
      <a
        href={localizedPath('/', locale)}
        class="flex items-center gap-1 text-sm font-medium text-foreground/75 transition hover:text-foreground"
      >
        <IconArrowBack className="size-4" />
        {t('pages.tool_details.back')}
      </a>
    </nav>
    <article
      class="prose text-pretty prose-zinc dark:prose-invert prose-headings:font-heading prose-headings:font-black"
    >
      <header>
        <h1 class="mb-0">{tool.data.name}</h1>
        <p class="mt-4 text-xl">{tool.data.summary}</p>
        <dl class="space-y-2">
          <div class="flex gap-1.5">
            <dt class="mt-0 font-semibold text-nowrap">{t('pages.tool_details.category')}:</dt>
            <dd class="mt-0 pl-0">
              {toSortedList(tags.map((tag) => tag.data.name))}
            </dd>
          </div>
          {
            tool.data.synonyms && (
              <div class="flex gap-1.5">
                <dt class="mt-0 font-semibold text-nowrap">{t('pages.tool_details.also_known_as')}:</dt>
                <dd class="mt-0 pl-0">{toSortedList(tool.data.synonyms)}</dd>
              </div>
            )
          }
        </dl>
      </header>
      <hr class="!my-8" />
      <Content />
    </article>
  </main>
</Layout>
