---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/utils/i18n';
import { getCollection, getEntry, render } from 'astro:content';
import IconArrowBack from '~icons/mdi/arrow-back';
import Layout from '@/layouts/layout.astro';
import { getLocale, getTranslations, locales, localizedPath, omitLocale, prependLocale } from '@/utils/i18n';
import Anchor from './anchor.astro';
import Blockquote from './blockquote.astro';
import H2 from './h2.astro';
import H3 from './h3.astro';

interface Props {
  tool: CollectionEntry<'tools'>;
}

const locale = getLocale(Astro);
const t = getTranslations(Astro, 'pages.tool_details');

const { tool } = Astro.props;

const tags = await getCollection('tags', (tag) => tool.data.tags.some((t) => prependLocale(t.id, locale) === tag.id));

const { Content } = await render(tool);

function toSortedList(items: string[]) {
  return items.toSorted((a, b) => a.localeCompare(b)).join(', ');
}

const paths: Partial<Record<Locale, string>> = {};

for (const locale of locales) {
  const entry = await getEntry('tools', `${locale}/${omitLocale(tool.id)}`);
  if (entry) {
    paths[locale] = localizedPath(`/${omitLocale(entry.data.path ?? entry.id)}`, locale);
  }
}
---

<Layout
  title={tool.data.seo?.title ?? tool.data.name}
  description={tool.data.seo?.description ?? tool.data.summary}
  noIndex={!tool.body}
  paths={paths}
  type="article"
>
  <main class="container mx-auto grid place-items-center px-4 py-10">
    <nav class="mb-8 w-full max-w-prose">
      <a
        href={localizedPath('/', locale)}
        class="flex items-center gap-1 text-sm font-medium text-foreground/75 transition hover:text-foreground"
      >
        <IconArrowBack className="size-4" />
        {t('back')}
      </a>
    </nav>
    <article
      class="prose text-pretty prose-zinc dark:prose-invert prose-headings:font-heading prose-headings:font-black"
    >
      <header>
        <h1 class="mb-0">{tool.data.name}</h1>
        <p class="mt-4 text-xl">{tool.data.summary}</p>
        <dl class="space-y-2">
          <div class="flex gap-1.5">
            <dt class="mt-0 font-semibold text-nowrap">{t('category')}:</dt>
            <dd class="mt-0 pl-0">
              {toSortedList(tags.map((tag) => tag.data.name))}
            </dd>
          </div>
          {
            tool.data.synonyms && (
              <div class="flex gap-1.5">
                <dt class="mt-0 font-semibold text-nowrap">{t('also_known_as')}:</dt>
                <dd class="mt-0 pl-0">{toSortedList(tool.data.synonyms)}</dd>
              </div>
            )
          }
        </dl>
      </header>
      <hr class="!my-8" />
      <Content components={{ h2: H2, h3: H3, a: Anchor, blockquote: Blockquote }} />
    </article>
  </main>
</Layout>
