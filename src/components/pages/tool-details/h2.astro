---
import { HeadingWithAnchor, type HeadingWithAnchorProps } from '@/components/mdx/heading-with-anchor';
import { getLocale, getTranslations } from '@/utils/i18n';

interface Props extends HeadingWithAnchorProps {}

const { id } = Astro.props;
const text = await Astro.slots.render('default');

const locale = getLocale(Astro);
const t = getTranslations(locale);
---

<HeadingWithAnchor
  type="h2"
  id={id}
  label={t('components.mdx.heading_with_anchor.anchor_label').replace('{name}', text)}
>
  <slot />
</HeadingWithAnchor>
