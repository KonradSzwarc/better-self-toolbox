---
import type { HTMLAttributes } from 'astro/types';
import MdiUndoVariant from '~icons/mdi/undo-variant';
import { getLocale, getTranslations } from '@/utils/i18n';
import { getHrefForMdxTool } from './anchor.utils';

export interface Props extends HTMLAttributes<'a'> {}

const { href: _href, ...props } = Astro.props;
let href = _href?.toString();

const locale = getLocale(Astro);
const t = getTranslations(Astro, 'pages.tool_details');

const isExternal = href && Astro.site && href.startsWith('http') && !href.includes(Astro.site.href);
if (isExternal) {
  props.target = '_blank';
  props.rel = 'noopener noreferrer nofollow';
}

const isFootnoteBackref = typeof props['data-footnote-backref'] === 'string';
if (isFootnoteBackref) {
  props['aria-label'] = t('footnote_back_label', { name: props['aria-label']?.split(' ').pop() ?? '' });
}

if (href?.endsWith('.mdx')) {
  href = await getHrefForMdxTool(href, locale);
}
---

<a href={href} {...props}>{isFootnoteBackref ? <MdiUndoVariant className="inline-block" /> : <slot />}</a>
