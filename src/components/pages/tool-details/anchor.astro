---
import type { HTMLAttributes } from 'astro/types';
import { getLocale, getTranslations } from '@/utils/i18n';
import MdiUndoVariant from '~icons/mdi/undo-variant';

export interface Props extends HTMLAttributes<'a'> {}

const { href, ...props } = Astro.props;

const locale = getLocale(Astro);
const t = getTranslations(locale);

function isHrefExternal(href?: string) {
  if (!href || !Astro.site) return false;
  return href.startsWith('http') && !href.includes(Astro.site.href);
}

const isExternal = isHrefExternal(href?.toString());
if (isExternal) {
  props.target = '_blank';
  props.rel = 'noopener noreferrer nofollow';
}

const isFootnoteBackref = typeof props['data-footnote-backref'] === 'string';
if (isFootnoteBackref) {
  props['aria-label'] = t('pages.tool_details.footnote_back_label').replace(
    '{name}',
    props['aria-label']?.split(' ').pop() ?? '',
  );
}
---

<a href={href} {...props}>{isFootnoteBackref ? <MdiUndoVariant className="inline-block" /> : <slot />}</a>
