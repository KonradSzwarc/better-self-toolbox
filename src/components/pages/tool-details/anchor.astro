---
import type { HTMLAttributes } from 'astro/types';
import MdiUndoVariant from '~icons/mdi/undo-variant';
import MdAnchor from '@/components/markdown-content/anchor.astro';
import { getLocale, getTranslations } from '@/utils/i18n';
import { getHrefForMdxTool } from './anchor.utils';

export interface Props extends HTMLAttributes<'a'> {}

const customProps: HTMLAttributes<'a'> = {};

const locale = getLocale(Astro);
const t = getTranslations(Astro, 'pages.tool_details');

const isFootnoteBackref = typeof Astro.props['data-footnote-backref'] === 'string';
if (isFootnoteBackref) {
  customProps['aria-label'] = t('footnote_back_label', { name: Astro.props['aria-label']?.split(' ').pop() ?? '' });
}

const href = Astro.props.href?.toString();
if (href?.endsWith('.mdx')) {
  customProps.href = await getHrefForMdxTool(href, locale);
}

const props = { ...Astro.props, ...customProps };
---

<MdAnchor href={href} {...props}>{isFootnoteBackref ? <MdiUndoVariant className="inline-block" /> : <slot />}</MdAnchor>
