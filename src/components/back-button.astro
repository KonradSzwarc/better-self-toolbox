---
import type { HTMLAttributes } from 'astro/types';
import IconArrowBack from '~icons/mdi/arrow-back';
import { getLocale, getTranslations, localizedPath } from '@/utils/i18n';

interface Props extends HTMLAttributes<'button'> {}

const locale = getLocale(Astro);
const t = getTranslations(Astro, 'components.back_button');
---

<a data-back-to-tools-list href={localizedPath('/', locale)} {...Astro.props}>
  <IconArrowBack />
  <span>{t('back')}</span>
</a>

<style>
  @reference '@/styles/global.css';

  a {
    @apply flex w-fit items-center gap-1.5 rounded-lg py-2 pr-2.5 pl-2 text-sm font-medium focus-visible:focus-outline;
    @apply opacity-75 transition-[background-color,opacity] duration-300 hover:opacity-100;
    @apply hover:bg-gray-100 dark:hover:bg-gray-800;

    svg {
      @apply size-4;
    }
  }
</style>

<script>
  function initBackToToolsList() {
    const backToToolsListButton = document.querySelector<HTMLAnchorElement>('[data-back-to-tools-list]');

    if (!backToToolsListButton) return;

    const isBackToToolsList = new URL(backToToolsListButton.href).pathname === new URL(document.referrer).pathname;

    if (!isBackToToolsList) return;

    backToToolsListButton.setAttribute('href', document.referrer);

    function handleButtonClick(event: MouseEvent) {
      event.preventDefault();
      window.history.back();
    }

    function handleAnyAnchorClick({ target }: MouseEvent) {
      if (target instanceof HTMLAnchorElement && target !== backToToolsListButton) {
        backToToolsListButton?.removeEventListener('click', handleButtonClick);
        document.removeEventListener('click', handleAnyAnchorClick);
      }
    }

    backToToolsListButton.addEventListener('click', handleButtonClick);
    document.addEventListener('click', handleAnyAnchorClick);
  }

  initBackToToolsList();
</script>
