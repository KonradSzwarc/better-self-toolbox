---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'li'> {
  value: string;
  checked: boolean;
}

const { value, checked, class: className, ...rest } = Astro.props;
---

<li class={className} {...rest}>
  <label class="flex items-center border px-2 py-1 select-none">
    <input data-tag-checkbox type="radio" value={value} checked={checked} class="sr-only" />
    <span><slot /></span>
  </label>
</li>

<style>
  @reference '@/styles/global.css';

  label:has(input:focus-visible) {
    @apply outline-2 outline-offset-2 outline-black;
  }

  label:has(input:checked) {
    @apply bg-black text-white;
  }

  label:has(input:not(:checked)) {
    @apply cursor-pointer;
  }
</style>
