---
import type { Locale } from '@/utils/i18n';
import { getLocale, getTranslations, localizedPath, omitLocale } from '@/utils/i18n';
import { cn } from '@/utils/styles';
import { LanguageSwitcherPreact } from './language-switcher.preact';

interface Props {
  class?: string;
  paths?: Partial<Record<Locale, string>>;
}

const { class: className, paths } = Astro.props;

const locale = getLocale(Astro);
const t = getTranslations(Astro, 'components.language_switcher');
const pathname = omitLocale(Astro.url.pathname);

const languages = {
  en: {
    flag: '🇬🇧',
    label: t('english'),
    path: paths?.en ?? localizedPath(pathname, 'en'),
  },
  pl: {
    flag: '🇵🇱',
    label: t('polish'),
    path: paths?.pl ?? localizedPath(pathname, 'pl'),
  },
} satisfies Record<Locale, object>;
---

<LanguageSwitcherPreact
  client:only="preact"
  label={t('label')}
  value={languages[locale].flag}
  languages={languages}
  className={className}
>
  <div slot="fallback" class={cn('size-8 border', className)}></div>
</LanguageSwitcherPreact>
