---
import { getLocale, getTranslations, localizedPath, omitLocale } from '@/utils/i18n';
import type { Locale } from '@/utils/i18n/constants';
import { cn } from '@/utils/styles';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {}

const { class: className, ...rest } = Astro.props;

const locale = getLocale(Astro);
const t = getTranslations(locale);
const pathname = omitLocale(Astro.url.pathname);

const languages = {
  en: {
    flag: '🇬🇧',
    label: t('components.language_switcher.english'),
    path: localizedPath(pathname, 'en'),
  },
  pl: {
    flag: '🇵🇱',
    label: t('components.language_switcher.polish'),
    path: localizedPath(pathname, 'pl'),
  },
} satisfies Record<Locale, object>;

const lang = languages[locale];
---

<div class={cn('relative inline-block size-fit', className)} {...rest}>
  <button
    type="button"
    id="language-switcher-button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="language-switcher-menu"
    aria-label={t('components.language_switcher.label')}
    class="flex size-8 cursor-pointer items-center justify-center rounded-full border transition-colors"
  >
    {lang.flag}
  </button>
  <div
    role="menu"
    id="language-switcher-menu"
    aria-labelledby="language-switcher-button"
    class="absolute top-10 right-0 z-50 hidden rounded border bg-white shadow-sm"
  >
    {
      Object.values(languages).map(({ flag, label, path }, i, arr) => (
        <>
          <a href={path} role="menuitem" tabindex="-1" class="block min-w-20 p-2 whitespace-nowrap text-zinc-950">
            {flag} {label}
          </a>
          {i < arr.length - 1 && <hr />}
        </>
      ))
    }
  </div>
</div>

<style>
  @reference '@/styles/global.css';

  button:focus-visible,
  a:focus-visible {
    @apply outline-2 outline-offset-2 outline-black;
  }
</style>

<script>
  const button = document.getElementById('language-switcher-button') as HTMLButtonElement;
  const menu = document.getElementById('language-switcher-menu') as HTMLElement;
  const items = menu.querySelectorAll('[role="menuitem"]') as NodeListOf<HTMLElement>;

  function openMenu() {
    menu.classList.replace('hidden', 'block');
    button.setAttribute('aria-expanded', 'true');
    items[0]?.focus();
  }

  function closeMenu() {
    menu.classList.replace('block', 'hidden');
    button.setAttribute('aria-expanded', 'false');
  }

  function handleButtonClick() {
    menu.classList.contains('block') ? closeMenu() : openMenu();
  }

  function handleButtonKeyDown(e: KeyboardEvent) {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      openMenu();
    }
  }

  function handleMenuKeyDown(e: KeyboardEvent) {
    if (!['ArrowDown', 'ArrowUp', 'Escape'].includes(e.key)) return;

    e.preventDefault();

    const index = Array.from(items).indexOf(document.activeElement as HTMLElement);

    switch (e.key) {
      case 'ArrowDown':
        items[(index + 1) % items.length]?.focus();
        break;
      case 'ArrowUp':
        items[(index - 1 + items.length) % items.length]?.focus();
        break;
      case 'Escape':
        closeMenu();
        button.focus();
        break;
    }
  }

  function handleDocumentClick(e: MouseEvent) {
    const target = e.target as Node;
    if (!button.contains(target) && !menu.contains(target)) {
      closeMenu();
    }
  }

  button.addEventListener('click', handleButtonClick);
  button.addEventListener('keydown', handleButtonKeyDown);
  menu.addEventListener('keydown', handleMenuKeyDown);
  document.addEventListener('click', handleDocumentClick);
</script>
