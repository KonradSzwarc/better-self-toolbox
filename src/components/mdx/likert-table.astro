---
import type { LikertTableProps } from './likert-table.preact';
import { getTranslations } from '@/utils/i18n';
import { LikertTablePreact } from './likert-table.preact';

interface Props extends Omit<LikertTableProps, 'totalLabel'> {}

const { items, max } = Astro.props;

const t = getTranslations(Astro, 'components.mdx.likert_table');
---

<LikertTablePreact client:load items={items} max={max} totalLabel={t('total')} />
