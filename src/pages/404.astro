---
import Layout from '@/layouts/layout.astro';
import { getLocale, getTranslations, localizedPath } from '@/utils/i18n';

const locale = getLocale(Astro);
const t = getTranslations(Astro, 'pages.404');
---

<Layout title={t('title')} description={t('description')}>
  <main class="flex min-h-dvh flex-col items-center justify-center px-4 text-center md:pb-[10vh]">
    <div class="max-w-prose text-balance">
      <h1 class="mb-4 font-heading text-7xl font-bold text-foreground">404</h1>
      <h2 class="mb-2 font-heading text-3xl font-bold text-foreground">{t('title')}</h2>
      <p class="mb-12 font-body text-lg text-foreground">{t('description')}</p>
      <a
        href={localizedPath('/', locale)}
        class="inline-block rounded bg-foreground px-6 py-3 font-semibold text-background"
      >
        {t('back')}
      </a>
    </div>
  </main>
</Layout>
