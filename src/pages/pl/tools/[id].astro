---
import { getCollection } from 'astro:content';
import ToolDetails from '@/components/pages/tool-details/index.astro';
import { entriesForLocale, omitLocale } from '@/utils/i18n';

export async function getStaticPaths() {
  const tools = await getCollection('tools', entriesForLocale('pl'));

  return tools.map((tool) => ({
    params: { id: omitLocale(tool.id) },
    props: { tool },
  }));
}

const { tool } = Astro.props;
---

<ToolDetails tool={tool} />
