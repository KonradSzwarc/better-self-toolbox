---
import '@/styles/global.css';

import '@fontsource-variable/inter';
import '@fontsource-variable/nunito';

// eslint-disable-next-line perfectionist/sort-imports -- side effects first
import interLatinExtUrl from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2';
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import nunitoLatinExtUrl from '@fontsource-variable/nunito/files/nunito-latin-ext-wght-normal.woff2?url';
import nunitoLatinUrl from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';

import ThemeSwitcherScript from '@/components/theme-switcher-script.astro';
import ThemeSwitcher from '@/components/theme-switcher.astro';
import { getLocale, localeCodes } from '@/utils/i18n';

interface Props {
  title: string;
  description: string;
  type?: 'article' | 'website';
}

const { title, description, type = 'website' } = Astro.props;

const locale = getLocale(Astro);

const interUrl = locale === 'pl' ? interLatinExtUrl : interLatinUrl;
const nunitoUrl = locale === 'pl' ? nunitoLatinExtUrl : nunitoLatinUrl;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!-- https://aykevl.nl/2014/09/fix-jumping-scrollbar  -->
<html lang={localeCodes[locale]} class="scroll-smooth lg:mr-0 lg:ml-[calc(100vw-100%)]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`/og-${locale}.png`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <link rel="preload" as="font" type="font/woff2" href={nunitoUrl} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin="anonymous" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <style>
      :root {
        --font-heading: 'Nunito Variable';
        --font-body: 'Inter Variable';
      }
    </style>
    <ThemeSwitcherScript />
  </head>
  <body class="bg-white font-body text-gray-900 antialiased dark:bg-gray-900 dark:text-white">
    <div class="relative flex h-0 w-full justify-end">
      <ThemeSwitcher class="absolute top-4 right-4" />
    </div>
    <slot />
  </body>
</html>
