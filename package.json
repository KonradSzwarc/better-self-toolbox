  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/ts-plugin": "1.10.4",
    "concurrently": "9.1.2",
    "eslint": "9.28.0",
    "eslint-config-flat-gitignore": "2.1.0",
    "eslint-plugin-astro": "1.3.1",
    "prettier": "3.5.3",
    "prettier-plugin-astro": "0.14.1"
  }
